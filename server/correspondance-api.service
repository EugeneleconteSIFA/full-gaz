[Unit]
Description=Correspondance - classement entre amis (correspondance.kernse.fr)
After=network.target

[Service]
ExecStart=/usr/bin/node /srv/correspondance/api/server/server.mjs
Environment=PORT=8160 SITE=/srv/correspondance/site
User=www-data
Group=www-data
StateDirectory=correspondance-api
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
